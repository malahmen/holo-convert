# Conversion output + working copies (created at runtime in the CWD)
output/
*.tmp.md

# Python bytecode from the .fcc/docx helpers
__pycache__/

# OS / editor cruft
.DS_Store
*.swp
*.swo

# Regenerated on every md->pdf run by detect_mono_font (holds a machine-local font path)
.fcc/pdf/monofont.tex
